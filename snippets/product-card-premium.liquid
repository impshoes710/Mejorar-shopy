{%- assign product = card_product -%}

<article class="product-card reveal">
  <a href="{{ product.url }}" class="product-card__link">
    <div class="product-card__media">
      {%- if product.featured_media -%}
        {{
          product.featured_media
          | image_url: width: 800
          | image_tag:
            class: 'product-card__img product-card__img--primary',
            loading: 'lazy',
            sizes: '(min-width: 990px) 25vw, 50vw',
            widths: '300, 400, 600, 800',
            alt: product.featured_media.alt | default: product.title
        }}
        {%- if product.media[1] != blank -%}
          {{
            product.media[1]
            | image_url: width: 800
            | image_tag:
              class: 'product-card__img product-card__img--hover',
              loading: 'lazy',
              sizes: '(min-width: 990px) 25vw, 50vw',
              widths: '300, 400, 600, 800',
              alt: product.media[1].alt | default: product.title
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'product-card__img product-card__img--primary' }}
      {%- endif -%}

      {%- if product.compare_at_price > product.price -%}
        <span class="product-card__badge">Oferta</span>
      {%- elsif product.tags contains 'nuevo' -%}
        <span class="product-card__badge">Nuevo</span>
      {%- endif -%}

      <div class="product-card__quick-add">
        <span class="btn btn--primary btn--full">Comprar</span>
      </div>
    </div>

    <div class="product-card__info">
      <h3 class="product-card__title">{{ product.title }}</h3>
      <div class="product-card__price">
        {%- if product.compare_at_price > product.price -%}
          <span class="product-card__price--compare">{{ product.compare_at_price | money }}</span>
        {%- endif -%}
        <span>{{ product.price | money }}</span>
      </div>
    </div>
  </a>
</article>
