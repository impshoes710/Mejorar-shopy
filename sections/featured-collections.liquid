<section class="section-padding reveal" id="collections-{{ section.id }}">
  <div class="container">
    <header class="section-header section-header--center">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-header__eyebrow text-uppercase">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="heading-lg">{{ section.settings.heading }}</h2>
    </header>

    <div class="collection-grid collection-grid--3">
      {%- for block in section.blocks -%}
        {%- assign coll = block.settings.collection -%}
        <a
          href="{{ block.settings.link | default: coll.url | default: '#' }}"
          class="collection-card"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 900
              | image_tag: class: 'collection-card__img', loading: 'lazy', alt: block.settings.title
            }}
          {%- elsif coll.featured_image != blank -%}
            {{
              coll.featured_image
              | image_url: width: 900
              | image_tag: class: 'collection-card__img', loading: 'lazy', alt: coll.title
            }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'collection-card__img' }}
          {%- endif -%}
          <div class="collection-card__overlay">
            <div>
              <h3 class="collection-card__title">{{ block.settings.title | default: coll.title }}</h3>
              <span class="collection-card__cta">Explorar →</span>
            </div>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Colecciones destacadas",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "Explora" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Colecciones" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Colección",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Sneakers" },
        { "type": "image_picker", "id": "image", "label": "Imagen editorial" },
        { "type": "collection", "id": "collection", "label": "Colección Shopify" },
        { "type": "url", "id": "link", "label": "Link personalizado" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Colecciones destacadas",
      "blocks": [
        { "type": "collection", "settings": { "title": "Sneakers" } },
        { "type": "collection", "settings": { "title": "Plataforma" } },
        { "type": "collection", "settings": { "title": "Casual" } },
        { "type": "collection", "settings": { "title": "Urban" } },
        { "type": "collection", "settings": { "title": "Elegantes" } },
        { "type": "collection", "settings": { "title": "New Collection" } }
      ]
    }
  ]
}
{% endschema %}
