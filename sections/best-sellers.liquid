<section class="section-padding reveal" id="best-sellers-{{ section.id }}">
  <div class="container">
    <header class="section-header section-header--center">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section-header__eyebrow text-uppercase">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="heading-lg">{{ section.settings.heading }}</h2>
      {%- if section.settings.description != blank -%}
        <p class="text-muted">{{ section.settings.description }}</p>
      {%- endif -%}
    </header>

    <div class="product-grid product-grid--4">
      {%- if section.settings.collection != blank -%}
        {%- assign collection = section.settings.collection -%}
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card-premium', card_product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <article class="product-card">
            <div class="product-card__media">
              {{ 'product-' | append: i | placeholder_svg_tag: 'product-card__img product-card__img--primary' }}
            </div>
            <div class="product-card__info">
              <h3 class="product-card__title">Producto ejemplo {{ i }}</h3>
              <div class="product-card__price"><span>$189.000</span></div>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all and section.settings.collection != blank -%}
      <div class="text-center" style="margin-top: 2.5rem;">
        <a href="{{ section.settings.collection.url }}" class="btn btn--outline-dark">
          {{ section.settings.view_all_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Best Sellers",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto superior", "default": "Lo más vendido" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Best Sellers" },
    { "type": "textarea", "id": "description", "label": "Descripción" },
    { "type": "collection", "id": "collection", "label": "Colección" },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Productos a mostrar",
      "default": 4
    },
    { "type": "checkbox", "id": "show_view_all", "label": "Botón ver todo", "default": true },
    { "type": "text", "id": "view_all_label", "label": "Texto ver todo", "default": "Ver toda la colección" }
  ],
  "presets": [{ "name": "Best Sellers" }]
}
{% endschema %}
