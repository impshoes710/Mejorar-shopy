<section class="video-lifestyle reveal" id="video-{{ section.id }}">
  {%- if section.settings.video != blank -%}
    {{
      section.settings.video
      | video_tag:
        autoplay: true,
        loop: true,
        muted: true,
        playsinline: true,
        class: 'video-lifestyle__video'
    }}
  {%- elsif section.settings.video_url != blank -%}
    <video
      class="video-lifestyle__video"
      autoplay
      loop
      muted
      playsinline
      {% if section.settings.poster != blank %}poster="{{ section.settings.poster | image_url: width: 1600 }}"{% endif %}
    >
      <source src="{{ section.settings.video_url }}" type="video/mp4">
    </video>
  {%- else -%}
    <div class="video-lifestyle__video" style="min-height:60vh;background:var(--color-dark);"></div>
  {%- endif -%}

  {%- if section.settings.show_caption -%}
    <div class="video-lifestyle__overlay">
      <div class="video-lifestyle__caption">
        {%- if section.settings.caption != blank -%}
          <p class="heading-md" style="margin:0;">{{ section.settings.caption }}</p>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Video Lifestyle",
  "tag": "section",
  "settings": [
    { "type": "video", "id": "video", "label": "Video (subir a Shopify)" },
    { "type": "text", "id": "video_url", "label": "URL video MP4 (alternativa)" },
    { "type": "image_picker", "id": "poster", "label": "Poster del video" },
    { "type": "checkbox", "id": "show_caption", "label": "Mostrar texto sobre video", "default": true },
    { "type": "text", "id": "caption", "label": "Texto", "default": "Tu estilo, tu ciudad." }
  ],
  "presets": [{ "name": "Video Lifestyle" }]
}
{% endschema %}
